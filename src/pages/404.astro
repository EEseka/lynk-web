---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Lynk" description="This link does not go anywhere.">
  <section class="flex min-h-dvh flex-col items-center justify-center px-4 py-32 text-center">
    <svg class="broken" width="160" height="160" viewBox="56 56 128 128" fill="none" aria-hidden="true">
      <path
        class="half half-pink"
        d="M129.614 114.021C127.399 111.059 124.572 108.609 121.326 106.835C118.081 105.062 114.491 104.007 110.802 103.743C107.113 103.479 103.41 104.011 99.9443 105.304C96.4788 106.597 93.3319 108.62 90.717 111.236L82.9788 118.974L75.2407 126.712C70.5421 131.577 67.9422 138.092 68.001 144.855C68.0597 151.618 70.7725 158.088 75.5549 162.87C80.3373 167.653 86.8067 170.365 93.5698 170.424C100.333 170.483 106.848 167.883 111.713 163.185L120.535 154.363"
        stroke="#FF6584"
        stroke-width="16"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        class="half half-indigo"
        d="M110.386 126.404C112.601 129.366 115.428 131.816 118.674 133.59C121.919 135.363 125.509 136.418 129.198 136.682C132.887 136.946 136.59 136.414 140.056 135.121C143.521 133.828 146.668 131.806 149.283 129.19L164.759 113.713C169.458 108.848 172.058 102.333 171.999 95.5698C171.94 88.8067 169.228 82.3373 164.445 77.5549C159.663 72.7725 153.193 70.0597 146.43 70.001C139.667 69.9422 133.152 72.5421 128.287 77.2407L119.414 86.0622"
        stroke="#4D41DF"
        stroke-width="16"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>

    <p class="mt-10 font-mono text-sm text-outline">404</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">This link is broken</h1>
    <p class="mt-4 max-w-md text-lg text-on-surface-variant">
      The page you were looking for does not exist, or it has moved.
    </p>
    <a
      href="/"
      class="mt-10 inline-flex h-12 items-center rounded-full bg-primary-container px-6 font-semibold text-on-primary-container transition-transform duration-300 ease-out-soft hover:-translate-y-0.5"
    >
      Back to Lynk
    </a>
  </section>
</BaseLayout>

<style>
  .broken {
    overflow: visible;
  }

  .half {
    animation: drift-apart 1.4s var(--ease-out-soft) 0.3s forwards;
  }

  .half-indigo {
    --dx: 14px;
    --dy: -14px;
    --turn: 10deg;
  }

  .half-pink {
    --dx: -14px;
    --dy: 14px;
    --turn: -10deg;
  }

  @keyframes drift-apart {
    to {
      transform: translate(var(--dx), var(--dy)) rotate(var(--turn));
    }
  }

  .half {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
