---
import Download from '@lucide/astro/icons/download';
import LynkLogo from './LynkLogo.astro';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-8">
    <a href="/" class="group flex items-center gap-2" aria-label="Lynk home">
      <LynkLogo size={32} class="transition-transform duration-500 ease-out-soft group-hover:-rotate-12" />
      <span class="font-display text-2xl font-bold tracking-tight">Lynk</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main">
      <a
        href="/#features"
        class="hidden rounded-full px-4 py-2 text-sm font-medium text-on-surface-variant transition-colors hover:bg-surface-high hover:text-on-background md:block"
      >
        Features
      </a>
      <a
        href="/#how-it-works"
        class="hidden rounded-full px-4 py-2 text-sm font-medium text-on-surface-variant transition-colors hover:bg-surface-high hover:text-on-background md:block"
      >
        How it works
      </a>
      <a
        href="/#download"
        class="ml-2 flex items-center gap-2 rounded-full bg-primary-container px-4 py-2 text-sm font-semibold text-on-primary-container shadow-lg shadow-primary-container/20 transition-transform duration-300 ease-out-soft hover:-translate-y-0.5 active:translate-y-0"
      >
        <Download size={16} />
        Get the app
      </a>
    </nav>
  </div>
</header>

<style>
  #site-header[data-scrolled] {
    background-color: color-mix(in oklab, var(--background) 72%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--outline-variant) 60%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
  }

  #site-header {
    border-bottom: 1px solid transparent;
  }
</style>

<script>
  const header = document.getElementById('site-header');

  const updateHeader = () => {
    header?.toggleAttribute('data-scrolled', Math.max(window.scrollY, document.body.scrollTop) > 8);
  };

  updateHeader();
  document.addEventListener('scroll', updateHeader, { passive: true, capture: true });
</script>
