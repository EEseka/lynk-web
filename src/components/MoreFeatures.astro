---
import Bell from '@lucide/astro/icons/bell';
import Bookmark from '@lucide/astro/icons/bookmark';
import CalendarClock from '@lucide/astro/icons/calendar-clock';
import Copy from '@lucide/astro/icons/copy';
import MapIcon from '@lucide/astro/icons/map';
import Undo2 from '@lucide/astro/icons/undo-2';
import UserPlus from '@lucide/astro/icons/user-plus';
import Users from '@lucide/astro/icons/users';
import Vote from '@lucide/astro/icons/vote';

const cards = [
  {
    icon: Vote,
    title: 'Pick it or put it to a vote',
    body: 'Already know the spot? Pick it when you create the hangout. Not sure? Let the group decide.',
    accent: 'tertiary'
  },
  {
    icon: UserPlus,
    title: 'Invite by username',
    body: 'Find friends by their exact username. No phone numbers, and no access to your contacts.',
    accent: 'primary'
  },
  {
    icon: Bell,
    title: 'Answer invites from your inbox',
    body: 'See who is already going and where, then accept or decline in one tap.',
    accent: 'secondary'
  },
  {
    icon: Bookmark,
    title: 'Save the spots you love',
    body: 'Bookmark places worth going back to, then propose them straight from your favourites.',
    accent: 'secondary'
  },
  {
    icon: Users,
    title: 'Cap the headcount',
    body: 'Set the most people who can come. Anyone still deciding on an invite keeps their place.',
    accent: 'tertiary'
  },
  {
    icon: Undo2,
    title: 'Refunds on their own',
    body: 'Hangout called off, or you had to leave before payout? Your share comes back without asking.',
    accent: 'primary'
  },
  {
    icon: CalendarClock,
    title: 'Deadlines the host controls',
    body: 'Change or extend when shares are due, then decide what happens to anyone who has not paid.',
    accent: 'primary'
  },
  {
    icon: Copy,
    title: 'Get a ride',
    body: 'Copy the address of the chosen spot and paste it into whichever ride app you use.',
    accent: 'tertiary'
  },
  {
    icon: MapIcon,
    title: 'Look around first',
    body: 'Continue as a guest and explore spots on the map before you make an account.',
    accent: 'secondary'
  }
];
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-8 sm:py-32">
  <div class="max-w-2xl">
    <h3 data-reveal class="font-display text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
      And the little things that make it work
    </h3>
  </div>

  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((card, index) => (
        <li
          data-reveal
          data-reveal-delay={String((index % 3) + 1)}
          class="glow-card"
          style={`--accent-container: var(--${card.accent}-container); --on-accent-container: var(--on-${card.accent}-container)`}
        >
          <span class="icon">
            <card.icon size={22} />
          </span>
          <p class="mt-5 text-lg font-bold">{card.title}</p>
          <p class="mt-2 leading-relaxed text-on-surface-variant">{card.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .glow-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--outline-variant);
    border-radius: 24px;
    background: var(--surface-container-lowest);
    padding: 28px;
  }

  @media (prefers-color-scheme: dark) {
    .glow-card {
      background: var(--surface-container-low);
    }
  }

  .glow-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(320px circle at var(--x, 50%) var(--y, -40%), var(--accent-container), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .glow-card:hover::before {
    opacity: 0.2;
  }

  .icon {
    display: flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: var(--accent-container);
    color: var(--on-accent-container);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .glow-card:hover .icon {
    transform: scale(1.1) rotate(-8deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.glow-card').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const box = card.getBoundingClientRect();
      card.style.setProperty('--x', `${event.clientX - box.left}px`);
      card.style.setProperty('--y', `${event.clientY - box.top}px`);
    });
  });
</script>
