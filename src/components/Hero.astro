---
import BatteryFull from '@lucide/astro/icons/battery-full';
import Calendar from '@lucide/astro/icons/calendar';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Copy from '@lucide/astro/icons/copy';
import EllipsisVertical from '@lucide/astro/icons/ellipsis-vertical';
import MapPin from '@lucide/astro/icons/map-pin';
import Plus from '@lucide/astro/icons/plus';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import SignalHigh from '@lucide/astro/icons/signal-high';
import Sofa from '@lucide/astro/icons/sofa';
import Wifi from '@lucide/astro/icons/wifi';

import LynkLogo from './LynkLogo.astro';
import Odometer from './Odometer.astro';
import StoreButtons from './StoreButtons.astro';
import CandidateCard from './app/CandidateCard.astro';
import ChosenSpotCard from './app/ChosenSpotCard.astro';
import ParticipantAvatar from './app/ParticipantAvatar.astro';
import { ADA, EMMA, HANGOUT_DATE, HANGOUT_NAME, KEMI, PAY_BY_DATE, SHARE, TOLU } from '../data/people';
import { ELEGUSHI_BEACH, LANDMARK_BEACH } from '../data/spots';

const headlineFirstLine = ['Stop', 'arguing', 'in', 'the', 'group', 'chat.'];
---

<section class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-36 lg:pb-32">
  <div class="aurora" aria-hidden="true">
    <span class="blob blob-indigo"></span>
    <span class="blob blob-pink"></span>
    <span class="blob blob-magenta"></span>
    <span class="grid-lines"></span>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-16 px-4 sm:px-8 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="flex min-w-0 flex-col items-start">
      <p
        class="hero-in mb-6 inline-flex items-center gap-2 rounded-full border border-outline-variant bg-surface-lowest/60 px-3 py-1 font-mono text-xs text-on-surface-variant backdrop-blur"
        style="--delay: 0ms"
      >
        <span class="live-dot" aria-hidden="true"></span>
        Out now on Android
      </p>

      <h1 class="font-display text-[44px] leading-[1.02] font-bold tracking-tight sm:text-6xl lg:text-7xl">
        <span class="sr-only">Stop arguing in the group chat. Just Lynk.</span>
        <span aria-hidden="true">
          {
            headlineFirstLine.map((word, index) => (
              <>
                <span class="word" style={`--delay: ${120 + index * 70}ms`}>{word}</span>{' '}
              </>
            ))
          }
          <br />
          <span class="word" style="--delay: 620ms">Just</span>{' '}
          <span class="word text-brand-gradient pb-1" style="--delay: 700ms">Lynk.</span>
        </span>
      </h1>

      <p
        class="hero-in mt-6 max-w-xl text-lg leading-relaxed text-on-surface-variant sm:text-xl"
        style="--delay: 850ms"
      >
        Plan hangouts with your friends, vote on where to go in real time, and split the bill
        before anyone arrives.
      </p>

      <div class="hero-in mt-10 w-full max-w-[656px]" style="--delay: 1000ms">
        <StoreButtons />
      </div>

      <ul
        class="hero-in mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-on-surface-variant"
        style="--delay: 1150ms"
      >
        <li class="flex items-center gap-2">
          <ShieldCheck size={16} class="text-success" />
          Checkout by Paystack. Your card never touches Lynk
        </li>
        <li class="flex items-center gap-2">
          <MapPin size={16} class="text-secondary" />
          Your location is never saved
        </li>
      </ul>
    </div>

    <div class="phone-stage hero-in relative mx-auto" style="--delay: 400ms" aria-hidden="true">
      <div class="phone-tilt" data-tilt>
        <div class="hero-demo relative" data-timeline="1400,1300,1500,1200,1500,1500,1400,3600">
          <div class="phone">
            <div class="app-screen screen">
              <div class="screen-content">
                <div class="flex h-8 items-center justify-between px-6 type-body-small font-medium">
                  <span>9:41</span>
                  <span class="camera"></span>
                  <span class="flex items-center gap-1">
                    <SignalHigh size={14} />
                    <Wifi size={14} />
                    <BatteryFull size={16} />
                  </span>
                </div>

                <div class="flex h-16 items-center justify-between px-3">
                  <span class="flex size-12 items-center justify-center"><ChevronLeft size={24} /></span>
                  <span class="flex size-12 items-center justify-center"><EllipsisVertical size={24} /></span>
                </div>

                <div class="px-4 pt-4">
                  <p class="type-headline-small">{HANGOUT_NAME}</p>
                  <div class="mt-4 flex items-center gap-4">
                    <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-outline-variant bg-surface-variant text-on-surface-variant">
                      <Sofa size={24} />
                    </span>
                    <div class="flex flex-col gap-2">
                      <div class="flex items-center gap-2">
                        <span class="type-title-medium">Chill</span>
                        <span class="status">
                          <span class="app-chip app-chip--voting status-voting">Voting</span>
                          <span class="app-chip app-chip--scheduled status-scheduled">Scheduled</span>
                        </span>
                      </div>
                      <div class="flex items-center gap-2 text-on-surface-variant">
                        <Calendar size={16} />
                        <span class="type-body-medium">{HANGOUT_DATE}</span>
                      </div>
                    </div>
                  </div>

                  <div class="pt-5">
                    <div class="app-section-header">
                      <span>Going</span>
                      <span class="type-label-large text-on-surface-variant">
                        <Odometer from={2} to={4} index="(var(--going) - 2)" /> going
                      </span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="app-stack">
                        <ParticipantAvatar person={ADA} online />
                        <ParticipantAvatar person={KEMI} online />
                        <ParticipantAvatar person={TOLU} online class="late-joiner" data-at-1="is-in" />
                        <ParticipantAvatar person={EMMA} class="late-joiner" data-at-2="is-in" />
                      </span>
                      <span class="app-section-action">See all <ChevronRight size={16} /></span>
                    </div>
                  </div>

                  <div class="collapsible" data-at-0="is-open" data-at-5="">
                    <div>
                      <div class="pt-5">
                        <div class="app-section-header">
                          <span>Vote for a spot</span>
                          <span class="app-section-action"><Plus size={16} /> Propose</span>
                        </div>
                        <div class="flex flex-col gap-3" data-at-3="total-3" data-at-4="total-4">
                          <CandidateCard spot={LANDMARK_BEACH} data-at-3="is-leading is-mine votes-2" data-at-4="is-leading is-mine votes-3" />
                          <CandidateCard spot={ELEGUSHI_BEACH} data-at-3="votes-1" />
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="collapsible" data-at-5="is-open">
                    <div>
                      <div class="pt-5">
                        <div class="app-section-header">
                          <span>Chosen spot</span>
                          <span class="app-section-action">Get a ride <Copy size={16} /></span>
                        </div>
                        <ChosenSpotCard spot={LANDMARK_BEACH} />
                      </div>
                    </div>
                  </div>

                  <div class="collapsible" data-at-6="is-open">
                    <div>
                      <div class="pt-5">
                        <div class="app-section-header"><span>Payments</span></div>
                        <div class="app-card-outlined flex flex-col gap-3 p-4">
                          <div class="flex items-center justify-between">
                            <span class="type-body-medium text-on-surface-variant">Your share</span>
                            <span class="type-title-small">{SHARE}</span>
                          </div>
                          <div class="flex items-center justify-between">
                            <span class="type-body-medium text-on-surface-variant">Pay by</span>
                            <span class="type-title-small">{PAY_BY_DATE}</span>
                          </div>
                          <div class="app-divider"></div>
                          <span class="type-body-small text-on-surface-variant">Waiting for everyone to pay</span>
                          <span class="app-button app-button--primary">Pay my share</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="flash-slot">
                  <span class="app-flash" data-at-1="is-shown" data-at-2=""><CircleCheck size={20} /> Tolu is in</span>
                  <span class="app-flash" data-at-2="is-shown" data-at-3=""><CircleCheck size={20} /> Emma is in</span>
                  <span class="app-flash" data-at-7="is-shown"><CircleCheck size={20} /> Tolu has paid</span>
                </div>
              </div>
            </div>
          </div>

          <div class="push">
            <div class="flex items-center gap-2 type-label-small text-on-surface-variant">
              <span class="flex size-5 items-center justify-center rounded-full bg-surface-lowest">
                <LynkLogo size={12} />
              </span>
              Lynk · now
            </div>
            <p class="mt-2 type-title-small">{HANGOUT_NAME}</p>
            <p class="type-body-medium text-on-surface-variant">Ada locked in where you are going</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    border-radius: 9999px;
    opacity: 0.55;
    will-change: transform;
  }

  .blob-indigo {
    width: 720px;
    height: 720px;
    top: -260px;
    right: -160px;
    background: radial-gradient(circle, rgb(77 65 223 / 0.55), transparent 65%);
    animation: drift-a 22s ease-in-out infinite alternate;
  }

  .blob-pink {
    width: 560px;
    height: 560px;
    top: 220px;
    right: 220px;
    background: radial-gradient(circle, rgb(255 101 132 / 0.45), transparent 65%);
    animation: drift-b 26s ease-in-out infinite alternate;
  }

  .blob-magenta {
    width: 620px;
    height: 620px;
    top: -120px;
    left: -280px;
    background: radial-gradient(circle, rgb(157 34 154 / 0.28), transparent 65%);
    animation: drift-c 30s ease-in-out infinite alternate;
  }

  @media (prefers-color-scheme: dark) {
    .blob {
      opacity: 0.7;
    }
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--outline-variant) 40%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--outline-variant) 40%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent 75%);
  }

  @keyframes drift-a {
    to {
      transform: translate(-120px, 80px) scale(1.1);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate(140px, -60px) scale(0.9);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate(100px, 120px) scale(1.15);
    }
  }

  .hero-in,
  .word {
    animation: rise-in 1s var(--ease-out-soft) var(--delay, 0ms) both;
  }

  .word {
    display: inline-block;
    animation-name: word-in;
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(8px);
    }
  }

  .live-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--success);
  }

  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .phone-stage {
    width: 300px;
    perspective: 1400px;
  }

  .phone-tilt {
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out-soft);
  }

  .phone {
    height: 620px;
    padding: 10px;
    border-radius: 48px;
    background: linear-gradient(145deg, #2b2a33, #0b0b10 40%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.08),
      0 50px 100px -30px rgb(51 31 200 / 0.45),
      0 30px 60px -30px rgb(0 0 0 / 0.5);
    animation: float 7s ease-in-out infinite;
  }

  .screen {
    height: 100%;
    overflow: hidden;
    border-radius: 38px;
  }

  /* The screen is laid out at 360dp, the width of a typical Android phone, then scaled to fit. */
  .screen-content {
    position: relative;
    width: 360px;
    height: calc(600px / 0.7778);
    zoom: 0.7778;
  }

  .camera {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: #000;
  }

  @keyframes float {
    50% {
      transform: translateY(-12px);
    }
  }

  .hero-demo {
    --going: 2;
  }

  .hero-demo.step-1 { --going: 3; }
  .hero-demo.step-2 { --going: 4; }

  .hero-demo :global(.app-stack > .late-joiner) {
    width: 0;
    margin-left: 0;
    opacity: 0;
    transform: scale(0.4);
    transition:
      width 0.5s var(--ease-out-soft),
      margin 0.5s var(--ease-out-soft),
      opacity 0.3s ease,
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-demo :global(.app-stack > .late-joiner.is-in) {
    width: var(--size);
    margin-left: calc(var(--size) / -3);
    opacity: 1;
    transform: none;
  }

  .status {
    display: inline-grid;
  }

  .status > * {
    grid-area: 1 / 1;
    justify-self: start;
    transition: opacity 0.4s ease;
  }

  .status-scheduled {
    opacity: 0;
  }

  .hero-demo.step-5 .status-voting {
    opacity: 0;
  }

  .hero-demo.step-5 .status-scheduled {
    opacity: 1;
  }

  .collapsible {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.7s var(--ease-out-soft),
      opacity 0.5s ease;
  }

  .collapsible > div {
    min-height: 0;
    overflow: hidden;
  }

  .collapsible.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .flash-slot {
    position: absolute;
    top: 104px;
    right: 16px;
    left: 16px;
    display: grid;
    justify-items: center;
  }

  .flash-slot > * {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(-24px) scaleY(0.6);
    transform-origin: top;
    transition:
      opacity 0.3s ease,
      transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .flash-slot > :global(.is-shown) {
    opacity: 1;
    transform: none;
  }

  .push {
    position: absolute;
    top: 150px;
    left: -270px;
    display: none;
    width: 290px;
    padding: 14px 16px;
    border: 1px solid var(--outline-variant);
    border-radius: 24px;
    background: var(--surface-container-high);
    box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.4);
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-demo.step-5 .push {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 1360px) {
    .push {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .phone-stage {
      width: 280px;
    }

    .phone {
      height: 580px;
    }

    .screen-content {
      height: calc(560px / 0.7222);
      zoom: 0.7222;
    }
  }
</style>

<script>
  const canTilt =
    window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');

  if (canTilt && tilt) {
    const hero = tilt.closest('section');

    hero?.addEventListener('pointermove', (event) => {
      const box = tilt.getBoundingClientRect();
      const x = (event.clientX - (box.left + box.width / 2)) / window.innerWidth;
      const y = (event.clientY - (box.top + box.height / 2)) / window.innerHeight;
      tilt.style.setProperty('--tilt-y', `${(x * 14).toFixed(2)}deg`);
      tilt.style.setProperty('--tilt-x', `${(-y * 10).toFixed(2)}deg`);
    });

    hero?.addEventListener('pointerleave', () => {
      tilt.style.setProperty('--tilt-y', '0deg');
      tilt.style.setProperty('--tilt-x', '0deg');
    });
  }
</script>
