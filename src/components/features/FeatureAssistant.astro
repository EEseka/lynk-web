---
import { Image } from 'astro:assets';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Check from '@lucide/astro/icons/check';
import Copy from '@lucide/astro/icons/copy';
import Info from '@lucide/astro/icons/info';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import Share2 from '@lucide/astro/icons/share-2';
import Sparkles from '@lucide/astro/icons/sparkles';
import X from '@lucide/astro/icons/x';

import FeatureRow from '../FeatureRow.astro';
import { HANGOUT_NAME } from '../../data/people';
import { LANDMARK_BEACH, MURI_OKUNOLA_PARK } from '../../data/spots';

const QUESTION = 'What spots fit our vibe?';

const starters = [QUESTION, 'Somewhere easy for everyone to reach', 'Something budget friendly for the group'];

// The answer is split into words so it can type itself out, like the app's steady reveal
const answer = [
  { text: 'Two good fits for a chill Friday. ' },
  { text: 'Landmark Beach', bold: true },
  { text: ' is the easy one: close to everyone, with food and seats right by the water. ' },
  { text: 'Muri Okunola Park', bold: true },
  { text: ' is quieter, if the plan is mostly sitting and talking.' }
];

let wordIndex = 0;
const answerWords = answer.flatMap((part) =>
  part.text
    .split(/(?<= )/)
    .filter(Boolean)
    .map((word) => ({ word, bold: part.bold ?? false, index: wordIndex++ }))
);

const cards = [
  {
    spot: LANDMARK_BEACH,
    price: '₦₦',
    reason: 'Close to the middle of the group, with food and seats by the water.'
  },
  {
    spot: MURI_OKUNOLA_PARK,
    price: '₦',
    reason: 'Quiet and green, good for a long catch-up.'
  }
];
---

<FeatureRow
  eyebrow="Lynk AI"
  title="Not sure where to go? Just ask"
  body="Tell Lynk AI the vibe, the budget and the day. It searches real places, checks when they are open, and comes back with picks you can open, save or put straight on the ballot."
  points={[
    'In a hangout, it already knows the vibe, the date and what is on the ballot',
    'Every card is a real place from Google, never one it made up',
    'Ask on Discover too, for anywhere you are looking on the map'
  ]}
  accent="violet"
  reverse
>
  <Sparkles slot="icon" size={16} />

  <p
    slot="note"
    data-reveal
    data-reveal-delay="5"
    class="mt-8 flex max-w-lg items-start gap-3 rounded-lg bg-surface-low p-4 text-sm text-on-surface-variant"
  >
    <Info size={18} class="mt-0.5 shrink-0 text-violet" />
    Answers are written by AI and can get things wrong, so check the details before you go. Your
    chats are private to you.
  </p>

  <!--
    Step 0 shows the empty chat, 1 taps a starter, 2 searches, 3 reads details, 4 types the answer,
    5 shows the cards, 6 taps Suggest and 7 puts the spot on the ballot
  -->
  <div slot="demo" class="assistant-demo w-full max-w-[400px]" data-timeline="2000,700,1500,1300,2600,1600,600,4400" aria-hidden="true">
    <div class="app-screen app-frame">
      <div class="top-bar">
        <span class="nav-icon"><X size={24} /></span>
        <span class="type-title-large">Lynk AI</span>
      </div>

      <div class="chat">
        <div class="empty" data-at-2="is-gone">
          <span class="avatar"><Sparkles size={36} /></span>
          <p class="type-title-medium mt-4 text-center">Find a Spot for {HANGOUT_NAME}</p>
          <p class="type-body-medium mt-2 text-center text-on-surface-variant">
            Lynk AI knows the vibe, the date and what's already on the ballot. Ask for places that fit,
            then suggest the best ones to the group.
          </p>
          <div class="mt-6 flex w-full flex-col gap-2">
            {
              starters.map((starter, index) => (
                <span class="starter app-card-outlined type-body-medium" {...(index === 0 ? { 'data-at-1': 'is-pressed' } : {})}>
                  {starter}
                </span>
              ))
            }
          </div>
        </div>

        <div class="conversation">
          <div class="part" data-at-2="is-shown">
            <div class="flex justify-end pl-12">
              <span class="user-bubble">{QUESTION}</span>
            </div>
          </div>

          <div class="part" data-at-2="is-shown" data-at-4="">
            <p class="status type-label-large">
              <span class="status__label status__label--searching">Looking for spots…</span>
              <span class="status__label status__label--details">Checking the details…</span>
            </p>
          </div>

          <div class="part" data-at-4="is-shown">
            <p class="answer" data-at-4="is-typing">
              {
                answerWords.map(({ word, bold, index }) => (
                  <span class:list={['answer__word', { 'font-bold': bold }]} style={`--i: ${index}`}>
                    {word}
                  </span>
                ))
              }
            </p>
          </div>

          <div class="part" data-at-5="is-shown">
            <div class="flex flex-col gap-3">
              {
                cards.map((card, index) => (
                  <div class="spot-card">
                    <div class="flex items-center gap-3">
                      <Image src={card.spot.photo} alt="" width={112} height={112} class="spot-card__photo" />
                      <div class="flex min-w-0 flex-1 flex-col gap-1">
                        <span class="type-title-small truncate">{card.spot.name}</span>
                        <span class="type-body-small truncate text-on-surface-variant">
                          {card.spot.category} • {card.price}
                        </span>
                      </div>
                      {index === 0 ? (
                        <span class="suggest">
                          <span class="suggest__idle type-label-large" data-at-6="is-pressed">
                            Suggest
                          </span>
                          <span class="suggest__done type-label-large" data-at-7="is-shown">
                            <Check size={16} /> On the ballot
                          </span>
                        </span>
                      ) : (
                        <span class="suggest">
                          <span class="suggest__idle type-label-large">Suggest</span>
                        </span>
                      )}
                    </div>
                    <p class="type-body-medium mt-3 text-on-surface-variant">{card.reason}</p>
                  </div>
                ))
              }
              <div class="actions">
                <Copy size={20} />
                <Share2 size={20} />
                <RefreshCw size={20} />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="input-bar">
        <span class="input-bar__placeholder">Ask about a place</span>
        <span class="send"><ArrowUp size={24} /></span>
      </div>
    </div>
  </div>
</FeatureRow>

<style>
  .app-frame {
    display: flex;
    height: 660px;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--outline-variant);
    border-radius: 32px;
    padding: 0 16px 16px;
    box-shadow: 0 40px 80px -40px rgb(147 51 234 / 0.45);
  }

  /* LynkTopAppBar with the close button, as on AssistantScreen */
  .top-bar {
    display: flex;
    height: 64px;
    flex-shrink: 0;
    align-items: center;
    gap: 4px;
    margin-left: -12px;
  }

  .nav-icon {
    display: flex;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  /* Messages sit on the input bar and push older ones up, as a chat does */
  .chat {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* AssistantEmptyState */
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    transition:
      opacity 0.4s ease,
      transform 0.5s var(--ease-out-soft);
  }

  .empty.is-gone {
    opacity: 0;
    transform: translateY(-16px);
  }

  /* AssistantAvatar */
  .avatar {
    display: flex;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--violet-container);
    color: var(--on-violet-container);
  }

  .starter {
    padding: 12px 16px;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .starter.is-pressed {
    transform: scale(0.97);
    background: var(--surface-container-high);
  }

  .conversation {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Each part opens like AnimatedVisibility, so the chat grows without jumping */
  .part {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.6s var(--ease-out-soft),
      opacity 0.4s ease;
  }

  .part > * {
    min-height: 0;
    overflow: hidden;
  }

  .part.is-shown {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* UserMessageBubble */
  .user-bubble {
    border-radius: 20px 20px 4px 20px;
    background: var(--surface-container-highest);
    padding: 12px 16px;
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
  }

  /* AssistantStatusLine: a light band sweeps across the letters while it works */
  .status {
    display: grid;
  }

  .status__label {
    grid-area: 1 / 1;
    background: linear-gradient(
      90deg,
      var(--on-surface-variant) 0%,
      var(--on-surface-variant) 35%,
      var(--on-background) 50%,
      var(--on-surface-variant) 65%,
      var(--on-surface-variant) 100%
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sweep 1.4s linear infinite;
    transition: opacity 0.3s ease;
  }

  .status__label--details,
  .assistant-demo.step-3 .status__label--searching {
    opacity: 0;
  }

  .assistant-demo.step-3 .status__label--details {
    opacity: 1;
  }

  @keyframes sweep {
    from {
      background-position: 100% 0;
    }

    to {
      background-position: 0 0;
    }
  }

  /* AssistantAnswerText, bodyLarge at medium weight */
  .answer {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
  }

  .answer__word {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .answer.is-typing .answer__word {
    opacity: 1;
    transition-delay: calc(var(--i) * 45ms);
  }

  /* AssistantSpotCard, a filled LynkCard */
  .spot-card {
    border-radius: 16px;
    background: var(--surface-container-highest);
    padding: 12px;
  }

  .spot-card__photo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--surface-variant);
    object-fit: cover;
  }

  .suggest {
    display: grid;
    justify-items: end;
  }

  .suggest > span {
    grid-area: 1 / 1;
    padding: 4px 8px;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .suggest__idle {
    color: var(--primary);
    font-weight: 700;
  }

  .suggest__idle.is-pressed {
    transform: scale(0.9);
    opacity: 0;
  }

  .suggest__done {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--on-surface-variant);
    white-space: nowrap;
    opacity: 0;
  }

  .suggest__done.is-shown {
    opacity: 1;
  }

  /* AssistantAnswerActions */
  .actions {
    display: flex;
    gap: 16px;
    color: var(--on-surface-variant);
  }

  /* AssistantInputBar */
  .input-bar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    border-radius: 28px;
    background: var(--lavender-grey);
    padding: 8px 8px 8px 16px;
  }

  .input-bar__placeholder {
    color: color-mix(in oklab, var(--on-lavender-grey) 60%, transparent);
    font-size: 16px;
    line-height: 24px;
  }

  .send {
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--on-background) 10%, transparent);
    color: color-mix(in oklab, var(--on-surface-variant) 38%, transparent);
  }
</style>
