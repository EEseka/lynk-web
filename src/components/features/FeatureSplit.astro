---
import CircleCheck from '@lucide/astro/icons/circle-check';
import Wallet from '@lucide/astro/icons/wallet';

import FeatureRow from '../FeatureRow.astro';
import ParticipantRow from '../app/ParticipantRow.astro';
import { ADA, EMMA, KEMI, PAY_BY_DATE, TOLU, TOTAL_COST } from '../../data/people';

const states = [
  { text: 'Collecting from your guests', at: 0, until: 3 },
  { text: 'Everyone has paid. Your payout is queued.', at: 3, until: 4 },
  { text: 'Sending your payout', at: 4, until: 5 },
  { text: 'Paid out to your account', at: 5 }
];
---

<FeatureRow
  eyebrow="Split the bill"
  title="No more “I'll send it later”"
  body="The host enters the full bill and Lynk splits it evenly between everyone going. Each person pays their share before the host's deadline, and once everyone has paid, the money goes to the host's bank account."
  points={[
    'Secure checkout by Paystack. Your card details never touch Lynk',
    'Called off before payout? Everyone who paid gets their share back',
    'Deadline missed? The host removes who has not paid, or calls it off'
  ]}
  accent="primary"
>
  <Wallet slot="icon" size={16} />

  <div slot="demo" class="split-demo flex w-full max-w-[400px] flex-col gap-4" data-timeline="1200,1400,1400,1600,1600,3800" aria-hidden="true">
    <div class="app-screen app-frame relative pt-20">
      <div class="flash-slot">
        <span class="app-flash" data-at-1="is-shown" data-at-2=""><CircleCheck size={20} /> Tolu has paid</span>
        <span class="app-flash" data-at-2="is-shown" data-at-3=""><CircleCheck size={20} /> Kemi has paid</span>
        <span class="app-flash" data-at-3="is-shown" data-at-4=""><CircleCheck size={20} /> Emma has paid</span>
        <span class="app-flash" data-at-5="is-shown"><CircleCheck size={20} /> Your payout is on its way to your bank</span>
      </div>

      <div class="app-section-header"><span>Payments</span></div>
      <div class="app-card-outlined flex flex-col p-4">
        <div class="flex items-center justify-between">
          <span class="type-body-medium text-on-surface-variant">Total</span>
          <span class="type-title-small">{TOTAL_COST}</span>
        </div>
        <div class="collapsible" data-at-0="is-open" data-at-3="">
          <div>
            <div class="flex items-center justify-between pt-3">
              <span class="type-body-medium text-on-surface-variant">Pay by</span>
              <span class="type-title-small">{PAY_BY_DATE}</span>
            </div>
          </div>
        </div>
        <div class="app-divider my-3"></div>
        <span class="status">
          {
            states.map((state) => (
              <span
                class="type-body-small text-on-surface-variant"
                {...{ [`data-at-${state.at}`]: 'is-shown' }}
                {...(state.until ? { [`data-at-${state.until}`]: '' } : {})}
              >
                {state.text}
              </span>
            ))
          }
        </span>
      </div>
    </div>

    <div class="app-screen sheet-frame">
      <div class="app-sheet px-6 pb-6">
        <div class="app-sheet__handle"></div>
        <p class="type-title-large mb-4">Who's going</p>
        <p class="type-label-large mb-4 text-on-surface-variant">Going · 4</p>
        <div class="flex flex-col gap-4">
          <ParticipantRow person={ADA} isHost online />
          <ParticipantRow person={TOLU} data-at-1="is-paid" />
          <ParticipantRow person={KEMI} online data-at-2="is-paid" />
          <ParticipantRow person={EMMA} data-at-3="is-paid" />
        </div>
      </div>
    </div>
  </div>
</FeatureRow>

<style>
  .app-frame {
    overflow: hidden;
    border: 1px solid var(--outline-variant);
    border-radius: 32px;
    padding-right: 16px;
    padding-bottom: 20px;
    padding-left: 16px;
  }

  .sheet-frame {
    overflow: hidden;
    border: 1px solid var(--outline-variant);
    border-radius: 32px;
    background: var(--surface-container-low);
    box-shadow: 0 40px 80px -40px rgb(51 31 200 / 0.4);
  }

  .flash-slot {
    position: absolute;
    top: 16px;
    right: 16px;
    left: 16px;
    display: grid;
    justify-items: center;
  }

  .flash-slot > * {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(-24px) scaleY(0.6);
    transform-origin: top;
    transition:
      opacity 0.3s ease,
      transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .flash-slot > .is-shown {
    opacity: 1;
    transform: none;
  }

  .collapsible {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.6s var(--ease-out-soft),
      opacity 0.4s ease;
  }

  .collapsible > div {
    min-height: 0;
    overflow: hidden;
  }

  .collapsible.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .status {
    display: grid;
  }

  .status > * {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease-out-soft);
  }

  .status > .is-shown {
    opacity: 1;
    transform: none;
  }
</style>
