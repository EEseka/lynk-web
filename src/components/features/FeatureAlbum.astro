---
import { Image } from 'astro:assets';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import Download from '@lucide/astro/icons/download';
import Images from '@lucide/astro/icons/images';
import Pencil from '@lucide/astro/icons/pencil';
import Share2 from '@lucide/astro/icons/share-2';
import Trash2 from '@lucide/astro/icons/trash';
import X from '@lucide/astro/icons/x';

import FeatureRow from '../FeatureRow.astro';
import ParticipantAvatar from '../app/ParticipantAvatar.astro';
import { ALBUM_NAME, ALBUM_PHOTOS } from '../../data/album';
import { EMMA } from '../../data/people';

const COLUMNS = 3;
const openedPhoto = ALBUM_PHOTOS[0];

// The photos ripple in from the top left corner as the album scrolls into view
const revealDelay = (index: number) => {
  const row = Math.floor(index / COLUMNS);
  const column = index % COLUMNS;
  return String(Math.min(row + column + 1, 5));
};
---

<FeatureRow
  eyebrow="Keep the memories"
  title="The pictures, finally in one place"
  body="When the hangout is done, everyone who went drops their shots into one album. No more begging the group chat to send them, and no more pictures stuck on one person's phone."
  points={[
    'Only the people who went can see it',
    'Save your favourites to your phone, or share them',
    'Add a caption so everyone remembers the moment'
  ]}
  accent="tertiary"
  reverse
>
  <Images slot="icon" size={16} />

  <!-- Step 0 shows the album, step 1 taps the first photo, step 2 opens it in the viewer -->
  <div slot="demo" class="w-full max-w-[400px]" data-timeline="2200,500,5200" aria-hidden="true">
    <div class="app-screen app-frame">
      <div class="top-bar">
        <span class="nav-icon"><ChevronLeft size={24} /></span>
        <span class="type-title-large truncate">{ALBUM_NAME}</span>
      </div>

      <div class="album-grid">
        {
          ALBUM_PHOTOS.map((albumPhoto, index) => (
            <Image
              src={albumPhoto.photo}
              alt=""
              width={240}
              height={240}
              class="thumbnail"
              data-reveal
              data-reveal-delay={revealDelay(index)}
              {...(index === 0 ? { 'data-at-1': 'is-pressed', 'data-at-2': '' } : {})}
            />
          ))
        }
      </div>

      <div class="viewer" data-at-2="is-open">
        <Image src={openedPhoto.photo} alt="" width={720} class="viewer__photo" />

        <div class="viewer__top">
          <ParticipantAvatar person={EMMA} size={32} />
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <span class="type-title-small">{EMMA.name}</span>
            <span class="type-body-small viewer__date">Sat 27 Sep · 4:12 PM</span>
          </div>
          <span class="tonal-button"><X size={24} /></span>
        </div>

        <div class="viewer__bottom">
          <p class="type-body-medium">came in clean, went home looking like a rainbow 😭</p>
          <div class="flex items-center gap-2">
            <span class="tonal-button"><Download size={24} /></span>
            <span class="tonal-button"><Share2 size={24} /></span>
            <span class="tonal-button"><Pencil size={24} /></span>
            <span class="tonal-button tonal-button--error"><Trash2 size={24} /></span>
            <span class="type-label-large ml-auto">1 / {ALBUM_PHOTOS.length}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</FeatureRow>

<style>
  .app-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--outline-variant);
    border-radius: 32px;
    padding-right: 16px;
    padding-bottom: 20px;
    padding-left: 16px;
    box-shadow: 0 40px 80px -40px rgb(125 0 124 / 0.45);
  }

  /* LynkTopAppBar with the back chevron, as on HangoutAlbumScreen */
  .top-bar {
    display: flex;
    height: 64px;
    align-items: center;
    gap: 4px;
    margin-left: -12px;
  }

  .nav-icon {
    display: flex;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  /* LazyVerticalGrid: 4dp gaps, HangoutPhotoThumbnail clipped to shapes.medium */
  .album-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin-top: 16px;
  }

  .thumbnail {
    aspect-ratio: 1;
    width: 100%;
    height: auto;
    border-radius: 12px;
    background: var(--surface-variant);
    object-fit: cover;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .thumbnail.is-pressed {
    transform: scale(0.94);
    filter: brightness(0.85);
  }

  /* HangoutPhotoViewer: a full screen dialog over the album, always in the dark theme */
  .viewer {
    --background: #000000;
    --on-background: #e4e1ee;
    --on-surface: #e4e1ee;
    --on-surface-variant: #c7c4d8;
    --surface-variant: #464555;
    --surface-container-high: #1e1d27;
    --error: #ffb4ab;

    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--background);
    color: var(--on-background);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .viewer.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .viewer__photo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Each bar sits on a scrim of the background at 72%, fading towards the photo */
  .viewer__top,
  .viewer__bottom {
    position: absolute;
    right: 0;
    left: 0;
  }

  .viewer__top {
    top: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 24px;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.72) 60%, transparent);
  }

  .viewer__bottom {
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 16px 16px;
    background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.72) 40%);
  }

  .viewer__date {
    color: var(--on-surface-variant);
  }

  /* LynkTonalIconButton */
  .tonal-button {
    display: flex;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--surface-container-high);
    color: var(--on-surface);
  }

  .tonal-button--error {
    color: var(--error);
  }
</style>
